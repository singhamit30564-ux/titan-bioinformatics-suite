{
    "name": "Titan Bioinformatics Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "latest",
            "profile": "minimal"
        },
        "ghcr.io/rocker-org/devcontainer-features/r-apt:2": {
            "packages": "r-base-dev,libxml2-dev,libcurl4-openssl-dev,libssl-dev"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker",
                "streamlit.streamlit",
                "rust-lang.rust-analyzer",
                "REditorSupport.r",
                "dbaeumer.vscode-eslint"
            ]
        }
    },
    "portsAttributes": {
        "8501": {
            "label": "Streamlit App",
            "onAutoForward": "notify",
            "protocol": "https"
        },
        "8000": {
            "label": "FastAPI (v1 + v2 job API)",
            "onAutoForward": "notify"
        },
        "4173": {
            "label": "Web dashboard (Express gateway)",
            "onAutoForward": "notify"
        },
        "5173": {
            "label": "Web dashboard (Vite dev)",
            "onAutoForward": "notify"
        }
    },
    "forwardPorts": [8501, 8000, 4173, 5173]
}
