{
  "components": {
    "schemas": {
      "APIRunRequest": {
        "description": "Privacy-friendlier JSON POST equivalent of the GET query endpoint.",
        "properties": {
          "frame": {
            "default": 0,
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Frame",
            "type": "integer"
          },
          "k": {
            "default": 3,
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "K",
            "type": "integer"
          },
          "mode": {
            "default": "transcribe",
            "maxLength": 32,
            "title": "Mode",
            "type": "string"
          },
          "nuclease": {
            "default": "SpCas9",
            "maxLength": 32,
            "title": "Nuclease",
            "type": "string"
          },
          "pam": {
            "default": "",
            "maxLength": 32,
            "title": "Pam",
            "type": "string"
          },
          "pattern": {
            "default": "",
            "maxLength": 1100,
            "title": "Pattern",
            "type": "string"
          },
          "seq": {
            "default": "",
            "maxLength": 50100,
            "title": "Seq",
            "type": "string"
          },
          "seq2": {
            "default": "",
            "maxLength": 50100,
            "title": "Seq2",
            "type": "string"
          },
          "tool": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "title": "APIRunRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobCreateRequest": {
        "properties": {
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "type": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "JobCreateRequest",
        "type": "object"
      },
      "JobListModel": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobSummaryModel"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "JobListModel",
        "type": "object"
      },
      "JobSummaryModel": {
        "description": "JSON-safe job status document (no sequence payloads).",
        "properties": {
          "artifacts": {
            "items": {
              "type": "string"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "created_utc": {
            "title": "Created Utc",
            "type": "string"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "engine_stats": {
            "additionalProperties": true,
            "title": "Engine Stats",
            "type": "object"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_utc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished Utc"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceSummary"
          },
          "started_utc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started Utc"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "progress",
          "created_utc"
        ],
        "title": "JobSummaryModel",
        "type": "object"
      },
      "ProvenanceSummary": {
        "properties": {
          "input_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Sha256"
          },
          "output_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Sha256"
          },
          "zero_data_retention": {
            "default": true,
            "title": "Zero Data Retention",
            "type": "boolean"
          }
        },
        "title": "ProvenanceSummary",
        "type": "object"
      },
      "UploadChunkRequest": {
        "properties": {
          "data_b64": {
            "minLength": 1,
            "title": "Data B64",
            "type": "string"
          },
          "final": {
            "default": false,
            "title": "Final",
            "type": "boolean"
          },
          "name": {
            "default": "upload.bin",
            "maxLength": 256,
            "title": "Name",
            "type": "string"
          },
          "offset": {
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "upload_id": {
            "maxLength": 64,
            "minLength": 8,
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "offset",
          "data_b64"
        ],
        "title": "UploadChunkRequest",
        "type": "object"
      },
      "UploadChunkResponse": {
        "properties": {
          "bytes_received": {
            "title": "Bytes Received",
            "type": "integer"
          },
          "complete": {
            "title": "Complete",
            "type": "boolean"
          },
          "upload_id": {
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "bytes_received",
          "complete"
        ],
        "title": "UploadChunkResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Titan Bioinformatics Tool API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/run": {
