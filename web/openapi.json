        "description": "GET /api/run?tool=gc_content&seq=ATGC",
        "operationId": "run_api_get_api_run_get",
        "parameters": [
          {
            "in": "query",
            "name": "tool",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Tool",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seq",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 50100,
              "title": "Seq",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seq2",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 50100,
              "title": "Seq2",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "pattern",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 1100,
              "title": "Pattern",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "default": "transcribe",
              "maxLength": 32,
              "title": "Mode",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "nuclease",
            "required": false,
            "schema": {
              "default": "SpCas9",
              "maxLength": 32,
              "title": "Nuclease",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "pam",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 32,
              "title": "Pam",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "k",
            "required": false,
            "schema": {
              "default": 3,
              "maximum": 12,
              "minimum": 1,
              "title": "K",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "frame",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 2,
              "minimum": 0,
              "title": "Frame",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Api Get Api Run Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Api Get"
      },
      "post": {
        "description": "JSON-body variant avoids placing sequence input in a URL.",
        "operationId": "run_api_post_api_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APIRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Api Post Api Run Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Api Post"
      }
    },
